# Скопировать в .env (он в .gitignore) и подставить значения.
# Ключ обязателен всегда: planTrip бросает ошибку до сети, если его нет.
# С моками годится любое непустое значение — мок проверяет только наличие.
EXPO_PUBLIC_TOMTOM_KEY=

# 1 — приложение ходит в настоящий TomTom (MSW не перехватывает api.tomtom.com).
#     Нужен реальный ключ. Парковки всё равно мокаются: реального API парковок не существует.
# 0 — всё через моки (по умолчанию). На тесты этот флаг не влияет: они всегда на моке.
EXPO_PUBLIC_TOMTOM_LIVE=0
